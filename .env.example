# Copy this file to .env for local development. On cPanel, prefer setting
# these directly in "Setup Python App" > Environment variables instead of
# shipping a .env file to the server.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-value

DEBUG=True

# Comma-separated, no scheme, e.g. yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, MUST include scheme, e.g. https://yourdomain.com
CSRF_TRUSTED_ORIGINS=

# Where the group actually is, not the server's location — this decides
# when a new day starts for the live room vs. the day archive (see
# chat/views.py). Use an IANA name, e.g. Asia/Dhaka, Asia/Kolkata, UTC.
TIME_ZONE=Asia/Dhaka

# --- Database ---------------------------------------------------------
# Leave USE_MYSQL unset/0 for local SQLite dev (zero setup).
# Set to 1 to use the MySQL database cPanel's "MySQL Databases" tool creates.
# cPanel prefixes both the DB name and DB user with your cPanel username,
# e.g. a database "communicator" as user "myuser" becomes DB_NAME=myuser_communicator.
USE_MYSQL=0
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# --- Security (leave unset in production to auto-derive from DEBUG=False) --
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# Only set once you've confirmed HTTPS works on every path of the domain:
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# --- App behaviour ------------------------------------------------------
MAX_ATTACHMENT_BYTES=15728640
SESSION_COOKIE_AGE=63072000
PRESENCE_WINDOW_SECONDS=45
CALL_RING_TIMEOUT_SECONDS=30
