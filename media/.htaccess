# Defense in depth. Attachments are normally only ever served through the
# authenticated Django view (chat.views.download), which checks the
# requester is a conversation participant before streaming a file — this
# folder is never meant to be reachable directly over the web. If it ever
# ends up under a web-executable document root anyway (misconfiguration,
# a different hosting setup, etc.), these two rules stop any uploaded file
# from being executed as a script, and stop directory contents from being
# listed.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|php\d?|phtml|pl|py|cgi|sh|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes -ExecCGI
